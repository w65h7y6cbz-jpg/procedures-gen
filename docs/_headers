# En-têtes pour Cloudflare Pages / Netlify — équivalent de staticwebapp.config.json,
# utile si l'hébergement retenu n'est pas Azure. Sans effet ailleurs.
/*
  Content-Security-Policy: frame-ancestors 'self' https://*.sharepoint.com https://*.office.com https://*.office365.com https://teams.microsoft.com https://*.teams.microsoft.com https://*.microsoft365.com

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable
