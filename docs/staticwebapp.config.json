{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "globalHeaders": {
    "content-security-policy": "frame-ancestors 'self' https://*.sharepoint.com https://*.sharepoint-df.com https://*.office.com https://*.office365.com https://teams.microsoft.com https://*.teams.microsoft.com https://*.microsoft365.com",
    "cache-control": "public, max-age=3600"
  },
  "routes": [
    {
      "route": "/fonts/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/js/vendor/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/fonts/*", "/assets/*", "/js/*", "/css/*", "*.json"]
  },
  "mimeTypes": {
    ".ttf": "font/ttf",
    ".yaml": "text/yaml"
  }
}
